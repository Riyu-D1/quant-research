# Quant research GPU environment: CUDA 12.1 runtime + pinned Python 3.11 (uv.lock)
# PyPI linux x86_64 wheels for torch 2.2-2.6 are built for CUDA 12.1 — matching base.
# No macOS OpenMP workarounds: linux wheels ship a single consistent runtime.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /usr/local/bin/

WORKDIR /app

# uv-managed standalone CPython 3.11 (no system python needed)
RUN uv python install 3.11

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
COPY Makefile ./
COPY results/published_leaderboard.csv ./results/published_leaderboard.csv

RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH" \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

CMD ["bash"]
